{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults and the app's own commands, each granted by name.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-check-setup",
    "allow-list-models",
    "allow-download-model",
    "allow-cancel-model-download",
    "allow-start-meeting",
    "allow-stop-meeting",
    "allow-set-mute",
    "allow-list-meetings",
    "allow-get-settings",
    "allow-set-setting",
    "allow-list-notes",
    "allow-add-note"
  ]
}

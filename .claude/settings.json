{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "env": {
    "PLAYBOOK_TEST_COMMAND": "scripts/check.sh quick"
  },
  "permissions": {
    "allow": [
      "Bash(cargo build)",
      "Bash(cargo build *)",
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(cargo clippy)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt)",
      "Bash(cargo fmt *)",
      "Bash(npm --prefix apps/ui run lint)",
      "Bash(npm --prefix apps/ui run lint *)",
      "Bash(npm --prefix apps/ui run format:check)",
      "Bash(npm --prefix apps/ui run format:check *)",
      "Bash(npm --prefix apps/ui run typecheck)",
      "Bash(npm --prefix apps/ui run test)",
      "Bash(npm --prefix apps/ui run test *)",
      "Bash(npm --prefix apps/ui test)",
      "Bash(npm --prefix apps/ui test *)",
      "Bash(npm --prefix apps/ui run build)",
      "Bash(npm --prefix apps/ui run e2e)",
      "Bash(npm --prefix apps/ui run e2e *)",
      "Bash(scripts/check.sh)",
      "Bash(scripts/check.sh *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME *)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./)",
      "Bash(rm -rf *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(curl * | sudo *)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./secrets/**)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(./**/.env.production)",
      "Read(./**/.env.development)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.test)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "mcp__playwright__browser_run_code_unsafe",
      "mcp__claude-in-chrome__javascript_tool"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-env-write.sh",
            "timeout": 10,
            "statusMessage": "Checking environment file protection"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-destructive.sh",
            "timeout": 10,
            "statusMessage": "Checking the command against the guardrails"
          }
        ]
      },
      {
        "matcher": "^mcp__.*([Pp]laywright|[Bb]rowser|[Cc]hrome)",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-browser-origin.sh",
            "timeout": 10,
            "statusMessage": "Checking the browser address"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-edit.sh",
            "timeout": 60,
            "statusMessage": "Formatting and linting the edited file"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-weakened-bar.sh",
            "timeout": 30,
            "statusMessage": "Checking the changes for a lowered quality bar"
          }
        ]
      }
    ]
  }
}
